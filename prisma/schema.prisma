generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  resumes       Resume[]
  jobs          Job[]
  applications  Application[]
  healthScores  HealthScore[]
  createdAt     DateTime      @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  headline  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model Resume {
  id        String     @id @default(cuid())
  userId    String
  label     String     @default("My Resume")
  fileUrl   String?
  text      String
  version   Int        @default(1)
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses  Analysis[]
  matches   Match[]
}

enum AnalysisType {
  resume
  linkedin
  site
}

enum AnalysisStatus {
  pending
  complete
  failed
}

model Analysis {
  id        String         @id @default(cuid())
  userId    String
  type      AnalysisType
  status    AnalysisStatus @default(pending)
  resumeId  String?
  sourceUrl String?
  score     Int?
  result    Json?
  error     String?
  createdAt DateTime       @default(now())
  resume    Resume?        @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

enum JobSource {
  ats
  paste
}

model Job {
  id              String        @id @default(cuid())
  userId          String?
  source          JobSource
  externalId      String?
  company         String
  title           String
  location        String?
  url             String?
  descriptionText String
  postedAt        DateTime?
  createdAt       DateTime      @default(now())
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches         Match[]
  applications    Application[]

  @@unique([source, externalId])
}

model Match {
  id        String   @id @default(cuid())
  resumeId  String
  jobId     String
  score     Int
  breakdown Json
  createdAt DateTime @default(now())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jobId])
}

enum AppStatus {
  saved
  applied
  interviewing
  offer
  rejected
}

model Application {
  id        String    @id @default(cuid())
  userId    String
  jobId     String
  status    AppStatus @default(saved)
  notes     String?
  appliedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model HealthScore {
  id        String   @id @default(cuid())
  userId    String
  resume    Int?
  linkedin  Int?
  site      Int?
  composite Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
